#include <Arduino.h>

constexpr byte AnimationLength = 14;
const uint8_t Animation[AnimationLength * 5] PROGMEM = {
    0x82, 0x83, 0x83, 0x83, 0x82,
    0x84, 0x86, 0x86, 0x86, 0x84,
    0x88, 0x8C, 0x8C, 0x8C, 0x88,
    0x90, 0x98, 0x98, 0x98, 0x90,
    0xA0, 0xB0, 0xB0, 0xB0, 0xA0,
    0xC0, 0xE0, 0xE0, 0xE0, 0xC0,
    0x80, 0xC0, 0xC0, 0xC0, 0x80,
    0xC0, 0xC0, 0xC0, 0xC0, 0xC0,
    0x80, 0xC0, 0xC0, 0xC0, 0x80,
    0xC0, 0xE0, 0xE0, 0xE0, 0xC0,
    0xA0, 0xB0, 0xB0, 0xB0, 0xA0,
    0x90, 0x98, 0x98, 0x98, 0x90,
    0x88, 0x8C, 0x8C, 0x8C, 0x88,
    0x84, 0x86, 0x86, 0x86, 0x84,
};

#define LCD_PROGMEM_CHARS Animation
#include <Lcd2004xs.h>

Lcd2004xs lcd(0x27, 16, 2);

const uint8_t delays[AnimationLength] = {
    180, 140, 110, 90, 70, 60, 50,
    150,
    50, 60, 70, 90, 110, 140
};

void setup()
{
    lcd.init();
    lcd.print(' ');
    for (int i = 0; i < AnimationLength; i++)
        lcd.saveCustomChar(i, nullptr); // registering
}

void loop()
{
    for (int i = 0; i < AnimationLength; i++)
    {
        lcd.print('\b');
        lcd.write(lcd.loadVirtualChar(i));
        delay(delays[i]);
    }
}
